# KAFKA - Broker de mensajería (eventos)
# Reemplaza con tu broker Kafka si no usas el proporcionado
KAFKA_BOOTSTRAP_SERVERS=213.199.42.57:9092

# SMTP - Configuración de email (notification_service)
# Para GMAIL: sigue los pasos en README.md (generar App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email_de_envio@gmail.com
SMTP_PASSWORD=contraseña_app_gmail
SMTP_FROM=email_receptor@gmail.com

# BASE DE DATOS - SQLite (rewards_service)
# sqlite:///./data/rewards.db (local, recomendado para desarrollo)
# postgresql://user:pass@localhost:5432/rewards (producción)
DATABASE_URL=sqlite:///./data/rewards.db

# LOGGING - Nivel de detalle de logs
# DEBUG = máximo detalle (desarrollo)
# INFO = eventos importantes (recomendado)
# WARNING = solo advertencias (producción)
# ERROR = solo errores
LOG_LEVEL=DEBUG
