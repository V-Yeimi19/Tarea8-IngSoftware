              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "meals"]
            },
            "description": "Paso 2: registrar una cena Gold (S/ 250). Guarda el `transaction_id` para el paso 3.\n\n**Recompensas esperadas:**\n- Puntos: `floor(250 × 1.5)` = **375 pts**\n- Cashback: `250 × 4.0%` = **S/ 10.00**"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cena registrada con 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('transactionId', json.transaction_id);",
                  "console.log('transactionId guardado:', json.transaction_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Consultar transacción registrada",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "meals", "{{transactionId}}"]
            },
            "description": "Paso 3: consultar la transacción registrada en el paso 2 usando el `transactionId` guardado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transacción encontrada con 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('El transaction_id coincide', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.transaction_id).to.eql(pm.collectionVariables.get('transactionId'));",
                  "});",
                  "",
                  "pm.test('El amount es 250', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(parseFloat(json.amount)).to.eql(250);",
                  "});",
                  "",
                  "pm.test('Flujo completo exitoso', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    console.log('Flujo completo: Health → POST /meals → GET /meals/:id completado correctamente');",
                  "});"
                ]
              }
