          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_number\": \"4532-ERROR-004\",\n  \"amount\": 100.00\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/meals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "meals"]
            },
            "description": "`restaurant_code` es un campo requerido. Omitirlo retorna 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 422', function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ]
              }
